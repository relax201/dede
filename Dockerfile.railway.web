# Railway Frontend — React static via nginx listening on $PORT
FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./

# Build-time public URLs (override in Railway service variables as Docker build args)
ARG VITE_API_URL
ARG VITE_WS_URL
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_WS_URL=${VITE_WS_URL}

RUN npm run build

FROM nginx:1.27-alpine AS runtime
RUN apk add --no-cache gettext
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.railway.conf /etc/nginx/conf.d/default.conf.template
COPY frontend/docker-entrypoint.railway.sh /docker-entrypoint.railway.sh
RUN chmod +x /docker-entrypoint.railway.sh
ENV PORT=80
EXPOSE 80
CMD ["/docker-entrypoint.railway.sh"]
