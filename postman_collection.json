    {
      "name": "🧪 اختبارات شاملة",
      "item": [
        {
          "name": "اختبار سيناريو كامل - تحليل سهم",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// اختبار الاستجابة الأساسية",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// اختبار بنية البيانات",
                  "pm.test('Response has required fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "// اختبار بيانات التحليل",
                  "pm.test('Analysis data is complete', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('symbol');",
                  "    pm.expect(jsonData.data).to.have.property('indicators');",
                  "    pm.expect(jsonData.data).to.have.property('current_price');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_version}}/analysis/SABIC",
              "host": ["{{base_url}}"],
