# =============================================================================
# تاسي فيجن / TASI Vision — Environment Variables
# =============================================================================

# Brand / App
APP_NAME=تاسي فيجن — TASI Vision
APP_VERSION=2.1.0
BRAND_NAME_AR=تاسي فيجن
BRAND_NAME_EN=TASI Vision
DEBUG=true
ENVIRONMENT=development
API_V1_STR=/api
TIMEZONE=Asia/Riyadh
ALLOWED_ORIGINS=http://localhost:3000

# Security (min 32 chars)
SECRET_KEY=replace-with-a-long-random-secret-key-32chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=100
AES_256_KEY_BASE64=replace-with-base64-32-byte-key
AUDIT_RETENTION_YEARS=5

# PostgreSQL
POSTGRES_PASSWORD=changeme_dev_only
DATABASE_URL=postgresql://tasi_user:changeme_dev_only@localhost:5432/tasi_platform

# ClickHouse
CLICKHOUSE_URL=clickhouse://default:@localhost:9000/tasi

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TICKS=tasi.ticks
KAFKA_TOPIC_NEWS=tasi.news

# SAHMK / سهمك — primary live (bare symbol 2222)
# Docs: https://www.sahmk.sa/en/developers/docs
# Auth header: X-API-Key  |  keys look like shmk_live_... or shmk_test_...
SAHMK_API_KEY=
SAHMK_BASE_URL=https://api.sahmk.sa/api/v1
SAHMK_WS_URL=wss://api.sahmk.sa/ws/v1/stocks/
SAHMK_RATE_LIMIT_PER_MINUTE=1000
SAHMK_TICK_INTERVAL_SECONDS=3

# LSEG Pro — history + failover (2222.SR, every 10s)
LSEG_API_KEY=
LSEG_BASE_URL=https://api.refinitiv.com
LSEG_RATE_LIMIT_PER_HOUR=2000
LSEG_FAILOVER_INTERVAL_SECONDS=10

# MarketAux Professional — news (bare 2222)
MARKETAUX_API_KEY=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
MARKETAUX_RATE_LIMIT_PER_MINUTE=200

# Backup providers
TADAWUL_API_KEY=
TADAWUL_BASE_URL=https://api.tadawul.com.sa
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Coverage
COVERAGE_BASIC_TARGET=350
COVERAGE_ADVANCED_TARGET=120

# Recommendation horizons
FORWARD_HORIZON_DEFAULT=5
FORWARD_HORIZONS=5,10,20

# Compliance
COMPLIANCE_MODE=analysis_disclaimer
CMA_PRELIMINARY_APPROVAL=true

# Cloud
AWS_REGION_PRIMARY=me-south-1
AWS_REGION_DR=eu-central-1
MONTHLY_BUDGET_USD_MIN=2000
MONTHLY_BUDGET_USD_MAX=3000

# ML / MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_ENSEMBLE_VERSION=champion

# Risk Engine
ATR_STOP_MULTIPLIER=2.0
REWARD_RISK_RATIO=2.5
RISK_PER_TRADE=0.015

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
