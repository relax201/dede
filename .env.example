# =============================================================================
# TASI AI Platform — Environment Variables
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# =============================================================================

# App
APP_NAME=منصة تحليل الأسهم السعودية — TASI AI
APP_VERSION=2.0.0
DEBUG=true
ENVIRONMENT=development
API_V1_STR=/api
TIMEZONE=Asia/Riyadh
ALLOWED_ORIGINS=http://localhost:3000

# Security (min 32 chars) — TLS 1.3 at edge; AES-256 for sensitive fields at rest
SECRET_KEY=replace-with-a-long-random-secret-key-32chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=100
AES_256_KEY_BASE64=replace-with-base64-32-byte-key

# PostgreSQL
POSTGRES_PASSWORD=changeme_dev_only
DATABASE_URL=postgresql://tasi_user:changeme_dev_only@localhost:5432/tasi_platform

# ClickHouse
CLICKHOUSE_URL=clickhouse://default:@localhost:9000/tasi

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TICKS=tasi.ticks
KAFKA_TOPIC_NEWS=tasi.news

# External Market Data
SAHMK_API_KEY=
SAHMK_BASE_URL=https://api.sahmk.example/v1
LSEG_API_KEY=
LSEG_BASE_URL=https://api.refinitiv.com
MARKETAUX_API_KEY=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1

# ML / MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_ENSEMBLE_VERSION=champion

# Risk Engine
ATR_STOP_MULTIPLIER=2.0
REWARD_RISK_RATIO=2.5
RISK_PER_TRADE=0.015

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
